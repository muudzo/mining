# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Data (large satellite files -- never commit)
data/raw/*
data/processed/*
data/training/*.tif
data/outputs/*.tif
data/outputs/*.png

# Keep directory structure
!data/**/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Test artifacts
.coverage
.coverage.*
.pytest_cache/

# Default output of `geomine audit` -- anyone following the README quickstart
# generates these in the repo root; the published artifacts live in benchmark/
audit_report.md
audit.json

# Secrets
.env
*.token
credentials.json

# Models (too large for git)
*.joblib
*.pkl
*.h5
*.pt

# Exception: the public audit benchmark model is small (a two-feature
# logistic regression, a few KB) and is the artifact the reproducibility
# claim depends on -- it must be committed, not ignored.
!benchmark/model.joblib

# Training data zips
prithvi_training_data.zip
*.zip
